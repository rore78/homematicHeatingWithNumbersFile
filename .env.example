# Homematic IP Addon -- Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# Verbindungsmodus: local (CCU3) oder cloud
HOMEMATIC_MODE=local

# CCU3-Adresse (bei lokaler Installation: localhost)
HOMEMATIC_CCU_HOST=localhost

# XML-RPC Port der CCU3
HOMEMATIC_CCU_PORT=2001

# Web-UI Port
PORT=8080

# Log-Detailgrad: debug, info, warn, error
LOG_LEVEL=info
