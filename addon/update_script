#!/bin/sh
# CCU3 Addon Update/Install Script
# Wird von der CCU3 Zusatzsoftware-Verwaltung aufgerufen

ADDON_ID="my-homematic-addon"
ADDON_DIR="/usr/local/addons/${ADDON_ID}"
ADDON_CONF_DIR="/usr/local/etc/config/addons/${ADDON_ID}"
RC_DIR="/usr/local/etc/config/rc.d"
WWW_DIR="/usr/local/etc/config/addons/www/${ADDON_ID}"

# Stoppe laufende Instanz
if [ -f "${RC_DIR}/${ADDON_ID}" ]; then
    "${RC_DIR}/${ADDON_ID}" stop 2>/dev/null || true
fi

# Erstelle Verzeichnisse
mkdir -p "${ADDON_DIR}"
mkdir -p "${ADDON_CONF_DIR}"
mkdir -p "${RC_DIR}"
mkdir -p "${WWW_DIR}"

# Kopiere Addon-Dateien
cp -r src "${ADDON_DIR}/"
cp -r public "${ADDON_DIR}/"
cp -r node_modules "${ADDON_DIR}/"
cp server.js "${ADDON_DIR}/"
cp package.json "${ADDON_DIR}/"

# Erstelle notwendige Verzeichnisse
mkdir -p "${ADDON_DIR}/schedules"
mkdir -p "${ADDON_DIR}/uploads"

# Behalte bestehende .env-Datei, erstelle nur falls nicht vorhanden
if [ ! -f "${ADDON_DIR}/.env" ]; then
    cat > "${ADDON_DIR}/.env" << 'ENVEOF'
# Generiert bei Installation -- anpassbar
HOMEMATIC_MODE=local
HOMEMATIC_CCU_HOST=localhost
HOMEMATIC_CCU_PORT=2001
PORT=8080
LOG_LEVEL=info
ENVEOF
fi

# Installiere RC-Skript (Start/Stop/Restart)
cp rc.d "${RC_DIR}/${ADDON_ID}"
chmod +x "${RC_DIR}/${ADDON_ID}"

# Installiere WWW-Konfiguration (fuer Web-UI Button in CCU)
cat > "${WWW_DIR}/index.htt" << 'HTTEOF'
<script type="text/javascript">
  window.location.href = '/addons/my-homematic-addon/';
</script>
HTTEOF

# Kopiere Addon-Konfiguration
cp addon.conf "${ADDON_CONF_DIR}/"

# Erstelle Web-Zugang ueber lighttpd (Reverse Proxy)
LIGHTTPD_CONF="/usr/local/etc/lighttpd_addon_${ADDON_ID}.conf"
cat > "${LIGHTTPD_CONF}" << 'LEOF'
# Reverse Proxy fuer my-homematic-addon
$HTTP["url"] =~ "^/addons/my-homematic-addon/" {
    proxy.server = ( "" => ( ( "host" => "127.0.0.1", "port" => 8080 ) ) )
}
LEOF

# Starte Addon
"${RC_DIR}/${ADDON_ID}" start 2>/dev/null || true

echo "Installation von ${ADDON_ID} abgeschlossen."
